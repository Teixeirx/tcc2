# ── Chaves de API (não versionar o .env real) ──────────────────────────────────
# Obtenha as chaves da Binance em:
# https://www.binance.com/en/my/settings/api-management
BINANCE_API_KEY=
BINANCE_SECRET_KEY=

# Chave do Google Gemini:
# https://aistudio.google.com/api-keys
GEMINI_API_KEY=
# Modelo usado na análise e no backtesting multimodal (padrão: gemini-3.5-flash-lite)
MODELO_GEMINI=gemini-3.5-flash-lite

# ── Interface web Flask ────────────────────────────────────────────────────────
# Usuário e senha do painel. Troque a senha antes de expor a aplicação.
WEB_ADMIN_USER=admin
WEB_ADMIN_PASS=troque-por-uma-senha-forte

# Gere com: python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=

# Use "production" para exigir WEB_ADMIN_PASS e cookies seguros.
CRIPTOIA_ENV=development

# Em produção (HTTPS), defina como 1.
SESSION_COOKIE_SECURE=0

# Mantenha 1. Só desative em testes automatizados controlados.
CSRF_ENABLED=1

# ── Parâmetros enxutos do LSTM na interface web ────────────────────────────────
LSTM_WEB_EPOCHS=8
LSTM_WEB_SEQ_LEN=16
LSTM_WEB_HIDDEN=16
LSTM_WEB_PASSO_RETREINO=2000
